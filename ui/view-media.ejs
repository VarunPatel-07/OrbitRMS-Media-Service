<!DOCTYPE html>
<html>
  <head>
    <!-- Dynamic Title -->
    <title><%= pdfName %> | OrbitRMS Media Viewer</title>

    <!-- Basic Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO Description -->
    <meta
      name="description"
      content="View and manage documents securely in OrbitRMS Media Service. Access <%= pdfName %> with fast and reliable document streaming." />

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f1f3f4;
        width: 100%;
        height: 100vh;
        padding: 0 !important;
        box-sizing: border-box;
        overflow: hidden;
      }

      .topbar {
        height: 50px;
        background: #ffffff;
        display: flex;
        align-items: center;
        padding: 0 20px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
        font-weight: 500;
      }

      iframe {
        width: 100%;
        height: 100vh;
        border: none;
      }
    </style>
  </head>
  <body>
    <iframe src="/media/stream/<%= folder %>/<%= id %>"></iframe>
  </body>
</html>
